# Copy this file to `.env` and adjust as needed for local (non-Docker) runs.

# SQLAlchemy connection string. Defaults to a local SQLite file if unset,
# so the app runs with zero external setup. docker-compose overrides this
# to point at the PostgreSQL container instead.
DATABASE_URL=sqlite:///./eve_diagnostics.db

JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared secret the simulated payment provider must send back on webhook
# calls (as the X-Webhook-Secret header).
WEBHOOK_SHARED_SECRET=dev-webhook-secret
